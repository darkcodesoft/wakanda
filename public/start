#!./node_modules/.bin/ts-node

const Server = require('./server')
const instance = Server.default.static()
const args = require('minimist')(process.argv.slice(2))
const greeter = require('../build/Release/greet.node')

// start server instance
if(!!args.port) {
    let port = parseInt(args.port)
    instance.setPort(port)
}

instance.router.get('/', (req, res) => {
    let message = greeter.hello()
    message += 'Teddy Mousse'

    res.status(200).send({ 'author': message })
})

instance.start()