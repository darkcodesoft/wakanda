extends ../partials/layout
block container
    div#dashboard.dashboard
        //- nav
        include ../partials/nav

        form.modal(tabindex="-1" role="dialog" action="/user/login" method="post" style="display:block; position: relative")
            div.modal-dialog.rounded-0.border-0(role="document" style="margin:0; padding: 0")
                div.modal-content.rounded-0.border-0
                    //- title
                    div.modal-header
                        h5.text-primary.modal-title Login
                    div.modal-body
                        //- error block
                        if error
                            div.p-2.mb-3.bg-danger.text-white.rounded.font-weight-lighter(style="font-size:12px")
                                if error.message
                                    = error.message
                                else
                                    = 'User Not Found.'
                        //- email input
                        div.form-group
                            input.form-control.border-0(type="text", placeholder="Email" name="email")
                        //- password input
                        div.form-group
                            input.form-control.border-0(type="password", placeholder="Password" name="password")
                    //- submit button
                    div.modal-footer
                        input.btn.btn-primary(type="submit", value="Submit")