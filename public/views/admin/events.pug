extends ../partials/layout
block container
    div#dashboard.dashboard
        //- nav
        include ../partials/nav

        div.list-group
            span#sys-message.list-group-item-action.list-group-item.d-flex.justify-content-between.align-items-center.rounded-0.active Total
                span.badge.badge-light.badge-pill #{count}
            for event in collection
                h6.list-group-item-action.list-group-item.d-flex.align-items-center(href="#" onclick="window.location='/admin/event/"+event.id+"'")
                    span.far.fa-comment-alt.mr-3
                    span.title #{event.name}