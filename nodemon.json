{
    "ignore": [
        "**/*.test.ts",
        "**/*.spec.ts",
        ".git",
        "build",
        "node_modules"
    ],
    "watch": [
        "src",
        "addons",
        "public"
    ],
    "exec": "npm run lint && ts-node ./public/index.ts --port=3001",
    "ext": "ts, cc, h, scss"
}
