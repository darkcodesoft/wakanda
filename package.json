{
  "name": "wakanda",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "gypfile": true,
  "scripts": {
    "start": "npm run test && npm run build && node ./build/Release/wakanda.js --port=7777",
    "dev": "./node_modules/nodemon/bin/nodemon.js",
    "build": "npm run build:c++ && npm run build:ts",
    "build:ts": "webpack",
    "build:c++": "node-gyp rebuild",
    "clean": "node-gyp clean",
    "test": "nyc mocha --require ts-node/register --watch-extensions ts 'src/**/*.test.ts' 'public/**/*.test.ts'"
  },
  "nyc": {
    "extension": [
      ".ts",
      ".tsx"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "reporter": [
      "html",
      "json"
    ],
    "all": true,
    "temp-dir": "./.coverage/tmp",
    "report-dir": "./.coverage"
  },
  "author": "storm2910@icloud.com",
  "license": "ISC",
  "devDependencies": {
    "@types/chai": "^4.1.7",
    "@types/cookie-parser": "^1.4.1",
    "@types/express": "^4.16.1",
    "@types/mocha": "^5.2.6",
    "@types/morgan": "^1.7.35",
    "@types/node": "^11.9.5",
    "@types/webpack": "^4.4.25",
    "@types/webpack-dev-server": "^3.1.2",
    "@types/webpack-node-externals": "^1.6.3",
    "chai": "^4.2.0",
    "mocha": "^5.2.0",
    "node-gyp": "^3.8.0",
    "nodemon": "^1.18.10",
    "nyc": "^13.3.0",
    "ts-loader": "^5.3.3",
    "ts-node": "^8.0.2",
    "typescript": "^3.3.3333",
    "webpack": "^4.29.6",
    "webpack-cli": "^3.2.3",
    "webpack-node-externals": "^1.7.2"
  },
  "dependencies": {
    "@types/http-errors": "^1.6.1",
    "cookie-parser": "^1.4.4",
    "debug": "^4.1.1",
    "express": "^4.16.4",
    "http-errors": "^1.7.2",
    "morgan": "^1.9.1",
    "node-addon-api": "^1.6.2",
    "pug": "^2.0.3"
  }
}
